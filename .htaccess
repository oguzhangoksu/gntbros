Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# Uygulama kodu, veriler ve yedekler dışarıdan erişilemez
RewriteRule ^(app|data)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known) - [F,L]


# Var olan dosya/klasörler doğrudan sunulur, geri kalan her şey index.php'ye
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|png|jpe?g|webp|avif|svg|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
